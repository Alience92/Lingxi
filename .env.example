# 灵犀记忆系统 · 环境变量模板
# 复制为 .env 并填入真实值

# ── LLM（分片/生成，必需）──
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ── 模型路径 ──
# 灵眸 encoder（macbert-2stage 通道分类）：stage1.onnx / stage2.onnx / tokenizer/vocab.txt
LINGXI_MODEL_DIR=D:/AgentMemory/tools/two-stage-output
# cognitive_v5 语义向量（1024 维句向量，本地 ONNX）
COGNITIVE_MODEL_PATH=D:/AgentMemory/tools/cognitive-model-output/cognitive_v5.onnx

# 注：语义层已完全本地化（cognitive_v5 / ONNX），不再需要 Ollama 或 bge-m3。

# ── 记忆库 ──
# 库路径解析顺序（先命中者生效）：
#   1. 宿主注入的 config.dbPath
#   2. LINGXI_DB_PATH
#   3. LINGXI_HOME/memory.db
#   4. 已存在的历史库（~/.agentmemory、~/.lingxi-server）—— 兼容，避免升级丢数据
#   5. ~/.lingxi/memory.db（全新安装默认位置）
# LINGXI_DB_PATH=C:/Users/Administrator/.agentmemory/memory.db
# LINGXI_HOME=C:/Users/Administrator/.lingxi

# ── 项目 / 用户隔离 ──
LINGXI_PROJECT_ID=C--Users-Administrator
# LINGXI_PROFILE_ID=user_default

# ── 语义层开关 ──
# 0 = 强制关闭语义检索（仅用 字图 + FTS5）；1 = 强制开启；不设 = 按模型是否可用自动判断
# LINGXI_SEMANTIC=

# ── 调试 ──
# LINGXI_DEBUG=1
# LINGXI_PERF_TIMING=1

# ── 已弃用（仍可用，命中时会打印一次警告）──
# AGENTMEMORY_MODEL_DIR   -> LINGXI_MODEL_DIR
# AGENTMEMORY_SEMANTIC    -> LINGXI_SEMANTIC
# AGENTMEMORY_PERF_TIMING -> LINGXI_PERF_TIMING
# AGENTMEMORY_HOME        -> 已移除，请改用 LINGXI_HOME 或 LINGXI_DB_PATH
